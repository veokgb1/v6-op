# V6OP environment template — copy to .env and fill in real values
# DO NOT commit .env

# K-line cache TTL in hours (default 24)
KLINE_CACHE_TTL_H=24

# Data source mode: set to "true" to skip network and use cache only
READ_CACHE_ONLY=false

# Fast scan mode: baostock only, skip akshare/yfinance fallback
FAST_FULL_SCAN=false

# Trade calendar provider: auto | baostock | akshare | weekend
TRADE_CALENDAR_PROVIDER=auto

# Prefetch workers (default 8)
PREFETCH_WORKERS=8
